# Copy this file to whatsapp_service/.env and fill in real values.
# NEVER commit the real .env file to git — add it to .gitignore.

# From Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Any string you invent yourself — you'll type this same value into the
# Meta App Dashboard's webhook configuration screen.
WHATSAPP_VERIFY_TOKEN=choose_a_random_secret_string

# YOUR WhatsApp number only, digits only, with country code, no '+' or spaces.
# Example for +1 555 123 4567 -> 15551234567
AUTHORIZED_WHATSAPP_NUMBER=15551234567

# Optional
WHATSAPP_API_VERSION=v20.0

# --- Shared task storage (so this cloud webhook and your desktop JARVIS
# see the SAME tasks, with zero syncing) ---
# Leave TODO_STORAGE_BACKEND unset (or "file") to use a local JSON file
# instead — fine for testing, but the cloud host and your desktop won't
# share tasks unless both point TODO_STORAGE_BACKEND at "firestore".
TODO_STORAGE_BACKEND=firestore

# Paste the ENTIRE contents of your Firebase service-account key .json
# file here as ONE line (most cloud hosts' env var boxes accept long
# single-line values fine). See whatsapp_service/README.md section 8.
FIREBASE_CREDENTIALS_JSON={"type": "service_account", "...": "..."}
