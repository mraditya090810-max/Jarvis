# Copy this file to telegram_service/.env and fill in real values.
# NEVER commit the real .env file to git — add it to .gitignore.

# From @BotFather on Telegram — message it "/newbot" and follow the prompts.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Any string you invent yourself — passed to Telegram via setup_webhook.py,
# then checked on every incoming request to prove it's really from Telegram.
TELEGRAM_WEBHOOK_SECRET=choose_a_random_secret_string

# YOUR numeric Telegram user ID (not your username). Get it for free by
# messaging @userinfobot on Telegram once — it replies with your ID instantly.
AUTHORIZED_TELEGRAM_USER_ID=123456789

# Only needed to run setup_webhook.py — the exact public HTTPS URL this
# service is reachable at, no trailing slash.
PUBLIC_BASE_URL=https://your-app.example.com

# Optional
AI_ANSWER_TIMEOUT_SECS=30
